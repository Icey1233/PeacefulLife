# Copy to .env on the server. Never upload .env to OSS or commit it.
PORT=5174
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5174
# Production: NODE_ENV=production, APP_ORIGIN=https://your-domain.example,
# HOST=0.0.0.0 behind an HTTPS reverse proxy; keep one Node process.
NODE_ENV=development

OSS_BUCKET=peaceful-life-data
# Confirmed bucket: peaceful-life-data.oss-cn-beijing.aliyuncs.com
OSS_REGION=oss-cn-beijing
# Optional; normally derived from OSS_REGION.
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional, if using temporary credentials (must be renewed before expiry).
OSS_STS_TOKEN=
